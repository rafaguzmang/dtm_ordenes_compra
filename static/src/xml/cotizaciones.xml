<template xml:space="preserve">
    <t t-name="dtm_ordenes_compra.cotizaciones" owl="1">

        <!-- KPIs -->
        <div class="dtm-content">
            <div class="dtm-kpi-grid">
                <div class="dtm-kpi-card c1">
                    <div class="dtm-kpi-label">Total Cotizaciones</div>
                    <div class="dtm-kpi-val" t-esc="this.state.cotizaciones_totales"/>
                    <div class="dtm-kpi-delta up">Este período</div>
                </div>
                <div class="dtm-kpi-card c2">
                    <div class="dtm-kpi-label">Terminadas</div>
                    <div class="dtm-kpi-val" t-esc="this.state.terminadas"/>
                    <div class="dtm-kpi-delta up">A Facturar</div>
                </div>
                <div class="dtm-kpi-card c3">
                    <div class="dtm-kpi-label">No Pagadas</div>
                    <div class="dtm-kpi-val">$<t t-esc="state.cotizaciones_no_pagadas"/></div>
                    <div class="dtm-kpi-delta up">Con Facturar</div>
                </div>
                <div class="dtm-kpi-card c4">
                    <div class="dtm-kpi-label">En Proceso</div>
                    <div class="dtm-kpi-val">$<t t-esc="state.acumulado"/></div>
                    <div class="dtm-kpi-delta up">Acumulado</div>
                </div>
            </div>

            <!--Entradas de activos por mes
            <div>
                <ActivosEntradas/>
            </div>
            -->

            <div class="ml-bar">
                <div class="ml-btn" t-on-click="() => this.materialALiberar()" t-attf-style="#{this.state.material_a_liberar ? 'border:3px solid #607D8B;' : ''}">
                    <div class="ml-dot" 
                        style="background:#E6F1FB;color:#0C447C;">
                        <t t-esc="this.state.material_a_liberar_count"/>
                    </div>
                    <span class="ml-name">Material por liberar</span>
                </div>

                <div class="ml-btn" t-on-click="() => this.ordenesAtoradas()" t-attf-style="#{this.state.ordenes_atoradas ? 'border:3px solid #607D8B;' : ''}">
                    <div class="ml-dot" style="background:#FAEEDA;color:#633806;"><t t-esc="this.state.ordenes_atoradas_count"/></div>
                    <span class="ml-name">Ordenes Detenidas</span>
                </div>

                <div class="ml-btn" t-on-click="() => this.porAprobar()" t-attf-style="#{this.state.por_aprobar ? 'border:3px solid #607D8B;' : ''}">
                    <div class="ml-dot" style="background:#E1F5EE;color:#085041;"><t t-esc="this.state.por_aprobar_count"/></div>
                    <span class="ml-name">Por Aprobar</span>
                </div>
                 <div class="ml-btn" t-on-click="() => this.enTransito()" t-attf-style="#{this.state.en_transito_check ? 'background: #ff0000;' : ''}">
                    <div class="ml-dot" style="background:#F1EFE8;color:#888780;"><t t-esc="this.state.en_transito_len"/></div>
                    <span class="ml-name">En Tránsito</span>
                </div>
                <div class="ml-btn" t-on-click="() => this.importantes_componente()">
                    <div class="ml-dot" style="background:#91c5ed;color:#888780;"><t t-esc="this.state.importantes_len"/></div>
                    <span class="ml-name">Importantes</span>
                </div> 
                <div class="ml-btn" t-on-click="() => this.diseno_dialogo()">
                    <div class="ml-dot" style="background:#afe5ec;color:#888780;"><t t-esc="this.state.endiseno_len"/></div>
                    <span class="ml-name">Diseño</span>
                </div> 
                <div class="ml-btn" t-on-click="() => this.nesteo_dialogo()">
                    <div class="ml-dot" style="background:#eff4ba;color:#888780;"><t t-esc="this.state.ennesteo_len"/></div>
                    <span class="ml-name">Nesteo</span>
                </div> 
                <div class="ml-btn" t-on-click="() => this.maquinados_dialogo()">
                    <div class="ml-dot" style="background:#eff4ba;color:#888780;"><t t-esc="this.state.maquinados_len"/></div>
                    <span class="ml-name">Maquinados</span>
                </div> 
            </div>

            

            <!-- Tabla -->
            <div class="dtm-table-card">
                <div class="dtm-tc-header">
                    <div>
                        <div class="dtm-tc-title">Registro de Cotizaciones</div>
                        <div class="dtm-tc-count"><t t-esc="state.cotizaciones.length"/> registros</div>
                    </div>                   
                    <div class="dtm-proceso-div">
                            <div class="dtm-tc-usd-card">
                                <span class="dtm-tc-usd-label">USD/MXN</span>
                                <span style="color: #ccc;">·</span>
                                <span class="dtm-tc-usd-price">$<t t-esc="state.precio_dollar"/></span>
                            </div>
                            <div class="dtm-proceso">
                                <span>Proceso</span>
                                <span style="color: #ccc;">·</span>                                
                            </div>    
                    </div>        
                </div>

                <div style="overflow-x:auto">
                    <table class="dtm-table">
                        <thead>
                            <tr>
                                <th>Cotización</th>
                                <th>P.O.</th>
                                <th>F.P.O</th>
                                <th>F. Entrega</th>
                                <th>Proveedor</th>
                                <th>Cliente</th>
                                <th style="text-align:right">Precio</th>
                                <th>F. Entrada</th>
                                <th style="text-align:center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Filtros -->
                            <tr class="dtm-filter-row">
                                <td><input type="number" min="0" placeholder="Nº" t-on-input="(ev) => this.cotizacionFiltro(ev)"/></td>
                                <td><input type="text" placeholder="PO..." t-on-input="(ev) => this.poFiltro(ev)"/></td>
                                <td></td>
                                <td><input type="date" name="fentrega_filtro" t-on-input="(ev) => this.fechaEntregaFiltro(ev)"/></td>
                                <td>
                                    <select name="proveedor_filtro" t-on-change="(ev) => this.proveedorFiltro(ev)">
                                        <option value="">Todos</option>
                                        <option value="dtm">DTM</option>
                                        <option value="mtd">MTD</option>
                                    </select>
                                </td>
                                <td>
                                    <select name="cliente_filtro" t-on-change="(ev) => this.clienteFiltro(ev)">
                                        <option value="">Todos</option>
                                        <t t-foreach="state.clientes" t-as="cliente" t-key="cliente">
                                            <option t-att-value="cliente"><t t-esc="cliente"/></option>
                                        </t>
                                    </select>
                                </td>
                                <td></td>
                                <td><input type="date" name="fentrada_filtro" t-on-input="(ev) => this.fechaEntradaFiltro(ev)"/></td>
                                <td>
                                    <select name="terminado_filtro" t-on-change="(ev) => this.terminadoFiltro(ev)">
                                        <option value="0">Todos</option>
                                        <option value="1">Terminado</option>
                                        <option value="2">Calidad</option>
                                        <option value="3">Proceso</option>
                                        <option value="4">OT</option>
                                        <option value="5">OD</option>
                                        <option value="6">PO</option>
                                    </select>
                                </td>
                            </tr>
                            <!-- Filtro por ot y por procesos -->
                             <tr class="dtm-filter-row">
                                <td><input type="number" min="0" placeholder="OT" t-on-input="(ev) => this.ordenTrabajoFiltro(ev)"/></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>
                                    <select name="proceso_filtro" t-on-change="(ev) => this.ordenTrabajoStatusFiltro(ev)">
                                        <option value="0">Todos</option>
                                        <option value="1">Nesteo</option>
                                        <option value="2">Corte</option>
                                        <option value="3">Soldadura</option>
                                        <option value="4">Maquinado</option>
                                        <option value="5">Pintura</option>
                                        <option value="6">Ensamble</option>
                                        <option value="7">Servicio Externo</option>
                                    </select>
                                </td>
                            </tr>

                            <!-- Datos -->
                            <t t-foreach="this.state.cotizaciones" t-as="cotizacion" t-key="cotizacion.cotizacion">
                                <tr class="dtm-dr"
                                    t-attf-style="background-color: #{cotizacion.facturado ? '#d4f7e0ff' : '#e9fdedff'}"
                                    t-on-click="() => this.ordenesTrabajo(cotizacion.cotizacion, cotizacion.precio, cotizacion.cliente, cotizacion.facturado, cotizacion.numero_factura)">
                                    <td>
                                        <span class="dtm-cot-link" t-att-class="cotizacion.atencion_material ? 'dtm-cot-material' : ''">
                                            <t t-esc="cotizacion.cotizacion"/>
                                        </span>
                                    </td>
                                    <td><span class="dtm-po-code"
                                        t-att-class="cotizacion.facturado ? 'bg-amarillo' : ''"
                                        t-on-click="(ev) => { ev.stopPropagation(); this.openPDF(cotizacion.pdf); }"><t t-esc="cotizacion.po"/></span></td>
                                    <td class="dtm-date-cell"><t t-esc="cotizacion.po_date"/></td>
                                    <td class="dtm-date-cell"><t t-esc="cotizacion.fecha_salida"/></td>
                                    <td>
                                        <span class="dtm-prov">
                                            <span class="dtm-prov-dot" t-attf-style="background:#{cotizacion.proveedor === 'DTM' ? '#2e7cf6' : '#8b5cf6'}"/>
                                            <t t-esc="cotizacion.proveedor"/>
                                        </span>
                                    </td>
                                    <td><t t-esc="cotizacion.cliente"/></td>
                                    <td class="dtm-price"><t t-esc="cotizacion.precio"/></td>
                                    <td class="dtm-date-cell"><t t-esc="cotizacion.fecha_entrada"/></td>
                                    <td style="text-align:center">
                                        <span t-attf-class="dtm-st dtm-st-#{cotizacion.status?.toLowerCase().replace(' ','-')}">
                                            <t t-esc="cotizacion.status"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="dtm-tc-footer">
                    <div class="dtm-pg-info">
                        Mostrando <t t-esc="state.cotizaciones.length"/> registros
                    </div>
                </div>
            </div>
        </div>

        <!-- Diálogo órdenes -->
        <div>
            <t t-if="this.state.ordenes_dialogo">
                <OrdenesTrabajo cerrar="cerrarOrdenesTrabajo"
                                cotizacion="this.state.cotizacion"
                                po_costo="this.state.po_costo"
                                cliente="this.state.cliente"
                                fcotizaciones="this.fetchCotizaciones"
                                facturado="this.state.facturado"
                                numero_factura="this.state.numero_factura"/>
            </t>
        </div>
        <!-- Abre el archivo PDF -->
        <t t-if="state.showPDF">
            <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">PO</h5>
                        <button type="button" class="btn-close" aria-label="Close" t-on-click="closePDF"></button>
                    </div>
                    <div class="modal-body">
                        <t t-if="state.pdf">
                            <iframe 
                                t-att-src="'data:application/pdf;base64,' + state.pdf"
                                class="pdf-iframe"
                                type="application/pdf">
                            </iframe>
                        </t>
                        <t t-else="">
                            <div class="alert alert-warning">No se encontró el PDF</div>
                        </t>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" t-on-click="closePDF">Cerrar</button> 
                    </div>
                    </div>
                </div>
            </div>
        </t>
        <!-- Abre el modal de el material en transito -->
        <t t-if="state.transito_dialogo">
           <TransitoDialogo cerrar="cerrarTransito"/>
        </t>
        <!-- Abre el componente de importantes -->
        <t t-if="state.importantes_componente">
                <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-xl">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Importantes</h5>
                                <button type="button" class="btn-close" aria-label="Close" t-on-click="cerrarImportantes_componente"></button>
                            </div>
                            <div class="modal-body">
                                <Importantes/>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" t-on-click="cerrarImportantes_componente">Cerrar</button> 
                            </div>
                        </div>
                    </div>
                </div>
           
        </t>
        <!-- Abre el componente de en bdiseño -->
        <t t-if="state.diseno_dialogo">
            <EnDisenoDialogo cerrar="cerrarDiseno_dialogo"/>
           
        </t>
        <!-- Abre el componente de en nesteo -->
        <t t-if="state.nesteo_dialogo">
           <EnNesteoDialogo cerrar="cerrarNesteo_dialogo"/>
        </t>
        <!-- Abre el componente de maquidados -->
        <t t-if="state.maquinados_dialogo">
           <EnMaquinadosDialogo cerrar="cerrarMaquinados_dialogo"/> 
        </t>
    </t>
</template>
