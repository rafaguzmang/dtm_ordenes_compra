<template xml:space="preserve">
    <t t-name="dtm_ordenes_compra.activosentradas" owl="1">
        <div class="ea-kpi" t-on-click="() => this.abrirEntradasActivos()">
        <!-- <div class="ea-kpi"> -->
            <div class="ea-kpi-top">
                <div>
                    <div class="dtm-kpi-label">Entradas de Activos · 2026</div>
                    <div class="ea-kpi-totals">
                        <div class="ea-kpi-total">
                            <span class="ea-dot ea-dot-debio"></span>
                            <span class="ea-total-label">Debió entrar</span>
                            <span class="ea-total-val"><t t-esc="state.totalDebioEntrar"></t></span>
                        </div>
                        <div class="ea-kpi-total">
                            <span class="ea-dot ea-dot-entro"></span>
                            <span class="ea-total-label">Entró</span>
                            <span class="ea-total-val"><t t-esc="state.totalFacturada"></t></span>
                        </div>
                        <div class="ea-kpi-total">
                            <span class="ea-dot ea-dot-pagadas"></span>
                            <span class="ea-total-label">Pagadas</span>
                            <span class="ea-total-val"><t t-esc="state.totalPagadas"></t></span>
                        </div>
                    </div>
                </div>
                <!-- <div class="ea-kpi-pct">
                    <div class="ea-kpi-pct-val"><t t-esc="state.porcentaje"></t></div>
                    <div class="ea-kpi-pct-label">cumplimiento</div>
                </div> -->
            </div>

            <!-- Mini gráfica (sparkline de 8 meses, datos fijos) -->
            <div class="ea-mini-chart">
                <t t-foreach="mesesVisibles" t-as="mes" t-key="mes">
                    <t t-set="conteos" t-value="getConteos(mes)"/>
                    <div class="ea-mini-col">
                        <div class="ea-mini-bars">
                            <span class="ea-mini-bar ea-mini-bar-debio"
                                t-attf-style="height: {{(conteos.total / maxCotizaciones) * 100}}%;"></span>
                            <span class="ea-mini-bar ea-mini-bar-entro"
                                t-attf-style="height: {{(conteos.facturadas / maxCotizaciones) * 100}}%;"></span>
                            <span class="ea-mini-bar ea-mini-bar-pagadas"
                                t-attf-style="height: {{(conteos.pagadas / maxCotizaciones) * 100}}%;"></span>
                        </div>
                        <span class="ea-mini-mes" t-esc="mes"></span>
                    </div>
                </t>
            </div>
        </div>
        <t t-if="state.abrirActivosDialogo">
            <ActivosDialogo/>
        </t>
    </t>
</template>
