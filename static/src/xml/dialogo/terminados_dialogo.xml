<template xml:space="preserve">
    <t t-name="dtm_ordenes_compra.terminados_dialogo" owl="1">
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Terminados<t t-esc="props.orden"/></h5>
                  <button type="button" class="btn-close" aria-label="Close" t-on-click="props.cerrar"></button>
                </div>
                <div class="nc-modal-body">
                    <div class="dc-table-section">  
                        <div class="dc-table-wrap">
                            <table class="dc-table">
                                <thead>                                          
                                <tr>
                                    <th>OT</th>                    
                                    <th>Tipo</th>
                                    <th>Versión</th>
                                    <th>Cliente</th>
                                    <th>Proyecto</th>
                                    <th>Diseñador</th>
                                </tr>
                                </thead>
                                <tbody id="dc-tbody">
                                    <t t-foreach="state.terminados" t-as="item" t-key="item_index">
                                        <tr t-on-click="() => openDialogoOrden(item.ot_number)">
                                            <td><span class="dc-od-badge"><t t-esc="item.ot_number"/></span></td>
                                            <td><span class="dc-cliente-chip"><t t-esc="item.tipo"/></span></td>
                                            <td class="dc-td--product"><t t-esc="item.version"/></td>                     
                                            <td><t t-esc="item.cliente"/></td>    
                                            <td><t t-esc="item.proyecto"/></td>                     
                                            <td><t t-esc="item.disenador"/></td>                     
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <t t-if="state.showOrden">
                                <OrdenesTrabajo 
                                    cerrar="closeDialogoOrden"
                                    cotizacion="state.cotizacion"
                                    po_costo="state.po_costo"
                                    cliente="state.cliente"
                                    fcotizaciones="state.fcotizaciones"
                                    facturado="state.facturado"
                                    numero_factura="state.numero_factura"                                            
                                />                                      
                            </t>
                        </div>                               
                    </div>   

               

                </div>                
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" t-on-click="props.cerrar">Cerrar</button> 
                  </div>
              </div>
            </div>
        </div> 
    </t>
</template>