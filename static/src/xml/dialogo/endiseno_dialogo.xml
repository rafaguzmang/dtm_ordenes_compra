                                            </div>
                                            <div class="modal-body">
                                                <iframe 
                                                    t-att-src="'data:application/pdf;base64,' + state.currentPDF"
                                                    class="pdf-iframe"
                                                    type="application/pdf">
                                                </iframe>
                                            </div>
                                            <div class="modal-footer">
