                                                        <td class="dc-td--po"><t t-esc="orden.precio"/></td>
                                                        <td class="dc-td--date"><t t-esc="orden.fecha_llegada"/></td>
                                                        <td class="dc-td--date">
                                                            <t t-if="orden.fecha_termino_diseno">
