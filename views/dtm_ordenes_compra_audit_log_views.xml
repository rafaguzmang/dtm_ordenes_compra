<odoo>
    <record id="dtm_ordenes_compra_audit_log_tree" model="ir.ui.view">
        <field name="name">dtm_ordenes_compra_audit_log_tree</field>
        <field name="model">dtm.ordenes.compra.audit.log</field>
        <field name="arch" type="xml">
            <tree delete="false" create="false" edit="false">
                <field name="fecha_evento"/>
                <field name="accion"/>
                <field name="usuario_id"/>
                <field name="no_cotizacion"/>
                <field name="orden_compra"/>
                <field name="origen"/>
                <field name="orden_id_original"/>
            </tree>
        </field>
    </record>

    <record id="dtm_ordenes_compra_audit_log_action" model="ir.actions.act_window">
        <field name="name">Bitácora</field>
        <field name="res_model">dtm.ordenes.compra.audit.log</field>
        <field name="view_mode">tree</field>
    </record>
    
    <!-- <menuitem id="menu_dtm_ordenes_compra_audit_log"  action="dtm_ordenes_compra_audit_log_action"/> -->
    
</odoo>